# The portfolio API (../backend), including the /api prefix.
API_BASE_URL=https://api.kaushikbhat.in/api

# This site's public site key (tenant "kaushik-bhat"). Not a secret — the API
# treats it as a tenant selector only — but it is only needed on the server.
API_SITE_KEY=

# Shared with the admin panel (PUBLIC_SITE_REVALIDATE_SECRET there). Guards
# POST /api/revalidate, which the panel calls after every content save.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REVALIDATE_SECRET=
